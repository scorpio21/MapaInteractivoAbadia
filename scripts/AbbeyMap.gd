func get_conexion(planta: int, x: int, y: int) -> int:
	match planta:
		0:
			if y < conexiones_planta_0.size() and x < conexiones_planta_0[y].size():
				return conexiones_planta_0[y][x]
		1:
			if y < conexiones_planta_1.size() and x < conexiones_planta_1[y].size():
				return conexiones_planta_1[y][x]
		2:
			if y < conexiones_planta_2.size() and x < conexiones_planta_2[y].size():
				return conexiones_planta_2[y][x]
	return 0

func get_nombre_habitacion(pos: Vector3i) -> String:
	return nombres_habitaciones.get(pos, "Desconocido")

func puede_ir_derecha(planta: int, x: int, y: int) -> bool:
	return (get_conexion(planta, x, y) & 0x01) != 0

func puede_ir_abajo(planta: int, x: int, y: int) -> bool:
	return (get_conexion(planta, x, y) & 0x02) != 0

func puede_ir_izquierda(planta: int, x: int, y: int) -> bool:
	return (get_conexion(planta, x, y) & 0x04) != 0

func puede_ir_arriba(planta: int, x: int, y: int) -> bool:
	return (get_conexion(planta, x, y) & 0x08) != 0

func puede_subir(planta: int, x: int, y: int) -> bool:
	return (get_conexion(planta, x, y) & 0x10) != 0

func puede_bajar(planta: int, x: int, y: int) -> bool:
	return (get_conexion(planta, x, y) & 0x20) != 0

func get_posiciones_abad() -> Dictionary:
	return posiciones_abad

func get_puertas() -> Array:
	return puertas
